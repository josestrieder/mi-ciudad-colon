{
  "expo": {
    "name": "Mi Ciudad Colón",
    "slug": "mi-ciudad-colon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "miciudadcolon",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "ar.edu.uner.miciudadcolon"
    },
    "android": {
      "package": "ar.edu.uner.miciudadcolon",
      "adaptiveIcon": {
        "backgroundColor": "#0B3A5D",
        "foregroundImage": "./assets/images/icon-frente.png",
        "monochromeImage": "./assets/images/icon-mono.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#0B3A5D"
          }
        }
      ],
      "@react-native-vector-icons/ionicons",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notificacion.png",
          "color": "#0B3A5D"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Mi Ciudad Colón usa la cámara para leer el código QR de los carteles.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Mi Ciudad Colón accede a tus fotos para que elijas la imagen de tu visita.",
          "cameraPermission": "Mi Ciudad Colón usa la cámara para que saques una foto en el lugar.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Mi Ciudad Colón usa tu ubicación para mostrarte qué lugares tenés cerca."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Mi Ciudad Colón usa Face ID para que vuelvas a entrar a tu cuenta sin escribir la contraseña."
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "59bde5b0-6953-48a2-81f5-2f06a96bd844"
      }
    }
  }
}
